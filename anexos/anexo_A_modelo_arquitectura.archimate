    <element xsi:type="archimate:ApplicationComponent" id="elem-app-mdm-tobe" name="Servicio de Maestro de Clientes MDM (To-Be)" />
    <element xsi:type="archimate:ApplicationComponent" id="elem-app-crm-tobe" name="Plataforma CRM/BPM de Cobranzas (To-Be)" />
    <element xsi:type="archimate:ApplicationComponent" id="elem-app-scoreapi-tobe" name="Motor Scoring API v2 con Explicabilidad (To-Be)" />
    <element xsi:type="archimate:ApplicationComponent" id="elem-app-itsm-tobe" name="Mesa de Servicio ITSM y Reclamos Integrado (To-Be)" />
    <element xsi:type="archimate:ApplicationComponent" id="elem-app-firmapki-tobe" name="Modulo de Firma Digital PKI Acreditada IOFE (To-Be)" />
