  <folder name="Technology &amp; Physical" id="f-tec" type="technology">
    <element xsi:type="archimate:Node" id="elem-tec-onprem" name="Servidor Local On-Premise Windows Server" />
    <element xsi:type="archimate:Node" id="elem-tec-ec2" name="Instancia AWS EC2 us-east-1 (Single-AZ)" />
    <element xsi:type="archimate:Node" id="elem-tec-rds" name="Amazon RDS PostgreSQL (Single-AZ)" />
    <element xsi:type="archimate:Node" id="elem-tec-workstations" name="Estaciones de Trabajo de Oficina (64 PCs)" />
    <element xsi:type="archimate:Node" id="elem-tec-byod" name="Dispositivos Moviles Personales BYOD" />
    <element xsi:type="archimate:Node" id="elem-tec-eks" name="Cluster AWS EKS Contenedores (Multi-AZ)" />
    <element xsi:type="archimate:Node" id="elem-tec-aurora" name="Amazon Aurora PostgreSQL Serverless Multi-AZ" />
    <element xsi:type="archimate:Node" id="elem-tec-worm" name="Boveda Inmutable AWS S3 Object Lock (WORM)" />
    <element xsi:type="archimate:Node" id="elem-tec-siem" name="Plataforma SIEM Centralizada / SOC 24/7" />
    <element xsi:type="archimate:Node" id="elem-tec-mdm" name="Agentes de Seguridad Movil MDM Corporativo" />
  </folder>
  <folder name="Motivation" id="f-mot" type="motivation">
    <element xsi:type="archimate:Principle" id="elem-pr-01" name="PR-01: Dato unico con fuente autoritativa y dueno designado" />
    <element xsi:type="archimate:Principle" id="elem-pr-02" name="PR-02: Integracion desacoplada mediante APIs y servicios seguros" />
    <element xsi:type="archimate:Principle" id="elem-pr-03" name="PR-03: Automatizacion end-to-end y erradicacion del Shadow IT" />
    <element xsi:type="archimate:Principle" id="elem-pr-04" name="PR-04: Privacidad, seguridad y cumplimiento normativo por diseno" />
    <element xsi:type="archimate:Principle" id="elem-pr-05" name="PR-05: Resiliencia, alta disponibilidad e inmutabilidad Cloud" />
    <element xsi:type="archimate:Principle" id="elem-pr-06" name="PR-06: Autoservicio omnicanal con explicabilidad algoritmica" />
  </folder>
  <folder name="Implementation &amp; Migration" id="f-imp" type="implementation_migration">
    <element xsi:type="archimate:WorkPackage" id="elem-wp-01" name="PT-01: Gobierno del Dato y Maestro MDM" />
