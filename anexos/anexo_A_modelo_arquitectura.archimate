    <element xsi:type="archimate:RealizationRelationship" id="rel-11" source="elem-wp-04" target="elem-app-crm-tobe" name="Implementa" />
    <element xsi:type="archimate:RealizationRelationship" id="rel-12" source="elem-wp-01" target="elem-app-mdm-tobe" name="Implementa" />
    <element xsi:type="archimate:RealizationRelationship" id="rel-13" source="elem-wp-07" target="elem-app-gw-tobe" name="Implementa" />
