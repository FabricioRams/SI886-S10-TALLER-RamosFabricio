    <element xsi:type="archimate:BusinessProcess" id="elem-bp-09" name="Conciliacion Bancaria y Tesoreria" />
    <element xsi:type="archimate:BusinessProcess" id="elem-bp-10" name="Analisis Financiero y Riesgo de Cartera" />
    <element xsi:type="archimate:BusinessObject" id="elem-bo-01" name="Solicitud de Credito" />
    <element xsi:type="archimate:BusinessObject" id="elem-bo-02" name="Maestro de Clientes" />
    <element xsi:type="archimate:BusinessObject" id="elem-bo-03" name="Pagare y Contrato" />
    <element xsi:type="archimate:BusinessObject" id="elem-bo-04" name="Saldo y Amortizacion" />
    <element xsi:type="archimate:BusinessObject" id="elem-bo-05" name="Comprobante Electronico SUNAT" />
    <element xsi:type="archimate:BusinessObject" id="elem-bo-06" name="Cartera y Tramo de Mora" />
