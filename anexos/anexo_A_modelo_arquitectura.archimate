    <element xsi:type="archimate:BusinessProcess" id="elem-bp-06" name="Ruteo y Cobranza Preventiva" />
    <element xsi:type="archimate:BusinessProcess" id="elem-bp-07" name="Gestion de Mora Prejudicial" />
