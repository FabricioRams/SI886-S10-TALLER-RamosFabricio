    <element xsi:type="archimate:WorkPackage" id="elem-wp-03" name="PT-03: Firma Digital PKI y Boveda de Pagares" />
    <element xsi:type="archimate:WorkPackage" id="elem-wp-04" name="PT-04: Plataforma CRM/BPM Cobranzas y Retiro Shadow IT" />
    <element xsi:type="archimate:WorkPackage" id="elem-wp-05" name="PT-05: Mesa de Servicio ITSM y Reclamos SBS" />
    <element xsi:type="archimate:WorkPackage" id="elem-wp-06" name="PT-06: Modernizacion de Scoring API v2" />
    <element xsi:type="archimate:WorkPackage" id="elem-wp-07" name="PT-07: Capa de Integracion API Gateway" />
    <element xsi:type="archimate:WorkPackage" id="elem-wp-08" name="PT-08: Infraestructura Cloud Multi-AZ y DRP" />
    <element xsi:type="archimate:WorkPackage" id="elem-wp-09" name="PT-09: Monitoreo Centralizado SIEM/SOC 24/7" />
  </folder>
  <folder name="Other" id="f-oth" type="other" />
  <folder name="Relations" id="f-rel" type="relations">
