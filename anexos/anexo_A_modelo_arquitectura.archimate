  <folder name="Application" id="f-app" type="application">
    <element xsi:type="archimate:ApplicationComponent" id="elem-app-portal-asis" name="Portal Web y App Movil v1 (As-Is)" />
    <element xsi:type="archimate:ApplicationComponent" id="elem-app-core-asis" name="Core de Creditos Legado Monolitico (As-Is)" />
    <element xsi:type="archimate:ApplicationComponent" id="elem-app-erp-asis" name="ERP Contable Concar Local (As-Is)" />
    <element xsi:type="archimate:ApplicationComponent" id="elem-app-hc01" name="HC-01: Hoja de Calculo Ruteo de Cobranzas (Shadow IT)" />
    <element xsi:type="archimate:ApplicationComponent" id="elem-app-hc04" name="HC-04: Hoja de Calculo Scoring Manual (Shadow IT)" />
    <element xsi:type="archimate:ApplicationComponent" id="elem-app-hc03" name="HC-03: Hoja de Calculo Conciliacion Bancaria (Shadow IT)" />
