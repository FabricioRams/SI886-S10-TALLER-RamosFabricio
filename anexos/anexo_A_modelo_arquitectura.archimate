<?xml version='1.0' encoding='utf-8'?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="CrediTech Peru - Modelo de Arquitectura Empresarial (PETI 2026-2028)" id="id-creditech-arch-model" version="5.0.0">
  <folder name="Strategy" id="f-strat" type="strategy" />
  <folder name="Business" id="f-bus" type="business">
    <element xsi:type="archimate:BusinessActor" id="elem-ba-cli" name="Cliente / Solicitante de Microcredito" />
    <element xsi:type="archimate:BusinessActor" id="elem-ba-ase" name="Asesor Comercial Digital" />
    <element xsi:type="archimate:BusinessActor" id="elem-ba-ana" name="Analista de Creditos y Riesgos" />
