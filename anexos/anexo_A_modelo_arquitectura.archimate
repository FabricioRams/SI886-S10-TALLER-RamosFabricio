    <element xsi:type="archimate:BusinessActor" id="elem-ba-fin" name="Analista de Tesoreria" />
    <element xsi:type="archimate:BusinessActor" id="elem-ba-cis" name="Oficial de Cumplimiento / CISO" />
    <element xsi:type="archimate:BusinessProcess" id="elem-bp-01" name="Toma de Solicitud y Onboarding Digital" />
    <element xsi:type="archimate:BusinessProcess" id="elem-bp-02" name="Evaluacion y Scoring de Riesgo Crediticio" />
    <element xsi:type="archimate:BusinessProcess" id="elem-bp-03" name="Formalizacion Contractual y Pagare" />
